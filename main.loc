--' Parallel evaluation over lists, streams, and stream files.
--'
--' Every function here is a drop-in for a sequential counterpart and returns
--' the same answer: results are in input order and do not depend on the worker
--' count. Parallelism is an implementation choice, not a change of meaning.
--'
--' The compiler realizes each function in the pool that already runs the
--' function being mapped, so the common case is an in-pool call. A mapped
--' function realized elsewhere still works; it simply pays a pool crossing per
--' work unit, which is what `chunkSize` is for.
module parallel (*)

import root


-- Scheduling
--------------

--' How a body of work is divided among workers.
--'
--' The default, `ShrinkingChunks`, hands out large units while work is
--' plentiful and single elements at the tail: each round deals one unit per
--' worker, sized at half the remaining work split evenly. It is the safe
--' choice under unknown cost: a run of cheap elements loses almost nothing to
--' coordination, and an expensive element near the end cannot strand a worker
--' holding a large block. The balancing is at the tail only; an expensive
--' element early in the input still travels inside a large first-round unit.
--'
--' `EvenChunks` splits into one contiguous block per worker and coordinates
--' not at all. It is the fastest schedule when element costs are uniform and
--' the worst when they are not: the run takes as long as the unluckiest block.
--'
--' `FixedChunks` takes units of exactly `chunkSize` elements. Reach for it
--' when the per-element cost is known and small enough that the unit size
--' should be set by hand.
data ParChunking = EvenChunks | ShrinkingChunks | FixedChunks

--' Whether results reach a sink in the order they were read or the order they
--' finished.
--'
--' Only the streaming functions consult this. The list functions always return
--' input order, because a list result is a value and its order is part of the
--' answer rather than a scheduling artifact.
--'
--' `InputOrder` delivers results in input order. It costs a reorder buffer:
--' a slow unit holds back everything that finished after it, and `inflight`
--' bounds how much that can be.
--'
--' `ArrivalOrder` permits reordering: results reach the sink in an
--' unspecified order, and batch boundaries at the sink may differ from those
--' of the source. Use it whenever the consumer does not care.
data ParOrder = InputOrder | ArrivalOrder

--' Tuning for the parallel combinators. `defaultParOpts` is the starting
--' point; override fields from it rather than building one from scratch, so a
--' later field does not silently change your meaning.
record ParOpts where
  --' Concurrent workers. `Null` selects the pool's core count.
  workers :: ?Int

  --' Elements per work unit. Read only under `FixedChunks`.
  chunkSize :: ?Int

  --' How work is divided.
  chunking :: ParChunking

  --' Result order where results reach a sink. Ignored by the list functions.
  order :: ParOrder

  --' Maximum work units dispatched but not yet delivered to the sink. Bounds
  --' the reorder buffer under `InputOrder` and the memory a stream stage
  --' holds, whatever the length of the source. `Null` selects twice the worker
  --' count. Read by the native stream stages; the `Pure` stages hold one
  --' batch at a time.
  inflight :: ?Int

--' Sensible defaults: every core, a shrinking schedule, input order.
defaultParOpts :: ParOpts
defaultParOpts =
  { workers = Null
  , chunkSize = Null
  , chunking = ShrinkingChunks
  , order = InputOrder
  , inflight = Null
  }


-- Lists
---------

--' Apply a function to every element, in parallel. Equivalent to `map`.
pmapWith :: ParOpts -> (a -> b) -> [a] -> [b]

--' Keep the elements satisfying a predicate, testing in parallel.
--' Equivalent to `filter`.
pfilterWith :: ParOpts -> (a -> Bool) -> [a] -> [a]

--' Apply a list-valued function to every element and concatenate the results,
--' in parallel. Equivalent to `concatMap`.
pconcatMapWith :: ParOpts -> (a -> [b]) -> [a] -> [b]

pmap :: (a -> b) -> [a] -> [b]
pmap f = pmapWith defaultParOpts f

pfilter :: (a -> Bool) -> [a] -> [a]
pfilter p = pfilterWith defaultParOpts p

pconcatMap :: (a -> [b]) -> [a] -> [b]
pconcatMap f = pconcatMapWith defaultParOpts f

--' Map each element into a monoid and combine the results.
--'
--' The map runs in parallel; the combine is a sequential left fold. That is
--' deliberate. The list is already in memory, so the fold is cheap next to the
--' mapping, and a fixed fold order makes the answer identical on four cores
--' and on sixty-four -- which a tree reduction over `Real` would not be, since
--' floating-point addition is not associative.
pfoldMapWith :: Monoid m => ParOpts -> (a -> m) -> [a] -> m
pfoldMapWith opts f xs = fold (<>) mempty (pmapWith opts f xs)

pfoldMap :: Monoid m => (a -> m) -> [a] -> m
pfoldMap f = pfoldMapWith defaultParOpts f

--' Apply many functions to one value, in parallel.
papply :: [a -> b] -> a -> [b]
papply fs x = pmap (\f -> f x) fs


-- Streams
-----------

--' The parallel stream stage: pull batches from a source, apply a list-valued
--' function to each element in parallel, push results to a sink.
--'
--' The source is an action returning the next batch, and an empty list at the
--' end -- which is exactly a partially applied `@next`. Taking an action rather
--' than a handle keeps the stage source-agnostic (a file, standard input,
--' anything that can produce batches) and makes it a producer in the shape
--' `@collect` consumes:
--'
--'     \@collect (psmap f (@next fi))
--'
--' This is a pipeline. The calling thread pulls and sinks while workers map,
--' so reading the next batch overlaps with computing the current one. Each
--' batch is split into work units by `chunking`; at most `inflight` units are
--' dispatched and not yet sunk. The sink sees results per work unit, in the
--' order `order` asks for, and never sees an empty list.
--'
--' A read failure is fatal here rather than returned. The producer shape
--' `@collect` requires has no room for a `Try`, and a stream that cannot be
--' read has nothing partial to hand back. Use `psfoldWith` when you want the
--' failure as a value.
psconcatMapWith
  :: ParOpts
  -> (a -> [b])
  -> <IO> (Try Str [a])
  -> ([b] -> <IO> ())
  -> <IO> ()
psconcatMapWith opts f pull sink = raiseRead (psconcatMapNative opts f (pullParts pull) sink)

--' Reduce a stream as results arrive, without materializing it.
--'
--' `f` runs in parallel; `combine` folds its results one element at a time,
--' in input order, on the calling thread. Because the fold order is fixed, the
--' answer does not depend on the worker count, the chunking or `order`, and
--' `combine` need not be associative -- a sum over `Real` is reproducible.
--' The price is that `combine` runs sequentially, so keep it cheap next to `f`.
--'
--' A read failure is returned as `Err`; a failure inside `f` or `combine` is
--' not a read failure and propagates.
psfoldWith
  :: ParOpts
  -> (b -> b -> b)
  -> b
  -> (a -> b)
  -> <IO> (Try Str [a])
  -> <IO> (Try Str b)
psfoldWith opts combine identity f pull = foldResult (psfoldNative opts combine identity f (pullParts pull))

psmapWith :: ParOpts -> (a -> b) -> <IO> (Try Str [a]) -> ([b] -> <IO> ()) -> <IO> ()
psmapWith opts f pull sink = raiseRead (psmapNative opts f (pullParts pull) sink)

psfilterWith :: ParOpts -> (a -> Bool) -> <IO> (Try Str [a]) -> ([a] -> <IO> ()) -> <IO> ()
psfilterWith opts p pull sink = raiseRead (psfilterNative opts p (pullParts pull) sink)

psmap :: (a -> b) -> <IO> (Try Str [a]) -> ([b] -> <IO> ()) -> <IO> ()
psmap f = psmapWith defaultParOpts f

psfilter :: (a -> Bool) -> <IO> (Try Str [a]) -> ([a] -> <IO> ()) -> <IO> ()
psfilter p = psfilterWith defaultParOpts p

psconcatMap :: (a -> [b]) -> <IO> (Try Str [a]) -> ([b] -> <IO> ()) -> <IO> ()
psconcatMap f = psconcatMapWith defaultParOpts f

psfoldMapWith :: Monoid m => ParOpts -> (a -> m) -> <IO> (Try Str [a]) -> <IO> (Try Str m)
psfoldMapWith opts f = psfoldWith opts (<>) mempty f

psfoldMap :: Monoid m => (a -> m) -> <IO> (Try Str [a]) -> <IO> (Try Str m)
psfoldMap f = psfoldMapWith defaultParOpts f


-- Streams in morloc
----------------------

--' The stream stages written in morloc rather than natively: a tail-recursive
--' loop that pulls a batch, maps it with the list combinator, sinks the
--' result, and repeats. They return the same answers as their native
--' counterparts (the `order` option aside, since results always arrive in
--' input order) and exist so the two can be compared.
--'
--' The difference is overlap. Here each batch is read, mapped and sunk before
--' the next is read, so one batch is in flight and `inflight` has no effect.
--' Each batch's work units start and finish together, so workers are started
--' once per batch rather than once per stage, and the sink receives one list
--' per batch rather than one per work unit.
psconcatMapWithPure
  :: ParOpts
  -> (a -> [b])
  -> <IO> (Try Str [a])
  -> ([b] -> <IO> ())
  -> <IO> ()
psconcatMapWithPure opts f pull sink = do
  r <- pull
  match r
    | (Err e) = @throw e
    | (Ok xs) = ? size xs == 0 = do
          ()
        : do
          sinkNonEmpty sink (pconcatMapWith opts f xs)
          psconcatMapWithPure opts f pull sink

--' Reduce a stream in morloc: map each batch in parallel, then fold it into
--' the accumulator in input order. See `psfoldWith` for the fold contract.
psfoldWithPure
  :: ParOpts
  -> (b -> b -> b)
  -> b
  -> (a -> b)
  -> <IO> (Try Str [a])
  -> <IO> (Try Str b)
psfoldWithPure opts combine identity f pull = psfoldPureLoop opts combine f pull identity

--' The loop behind `psfoldWithPure`, with the accumulator last so each
--' iteration is a tail call.
psfoldPureLoop
  :: ParOpts
  -> (b -> b -> b)
  -> (a -> b)
  -> <IO> (Try Str [a])
  -> b
  -> <IO> (Try Str b)
psfoldPureLoop opts combine f pull acc = do
  r <- pull
  match r
    | (Err e) = do
        Err e
    | (Ok xs) = ? size xs == 0 = do
          Ok acc
        : psfoldPureLoop opts combine f pull (fold combine acc (pmapWith opts f xs))

--' Hand a batch to a sink unless it is empty, matching the native stages.
sinkNonEmpty :: ([b] -> <IO> ()) -> [b] -> <IO> ()
sinkNonEmpty sink ys = ? size ys == 0 = do
    ()
  : sink ys

psmapWithPure :: ParOpts -> (a -> b) -> <IO> (Try Str [a]) -> ([b] -> <IO> ()) -> <IO> ()
psmapWithPure opts f pull sink = do
  r <- pull
  match r
    | (Err e) = @throw e
    | (Ok xs) = ? size xs == 0 = do
          ()
        : do
          sinkNonEmpty sink (pmapWith opts f xs)
          psmapWithPure opts f pull sink

psfilterWithPure :: ParOpts -> (a -> Bool) -> <IO> (Try Str [a]) -> ([a] -> <IO> ()) -> <IO> ()
psfilterWithPure opts p pull sink = do
  r <- pull
  match r
    | (Err e) = @throw e
    | (Ok xs) = ? size xs == 0 = do
          ()
        : do
          sinkNonEmpty sink (pfilterWith opts p xs)
          psfilterWithPure opts p pull sink

psfoldMapWithPure :: Monoid m => ParOpts -> (a -> m) -> <IO> (Try Str [a]) -> <IO> (Try Str m)
psfoldMapWithPure opts f = psfoldWithPure opts (<>) mempty f


-- Backend hooks
-----------------

--' The native stream primitives each language module implements. They are
--' exported only because a language module must see a signature to source it;
--' call the stages above instead.
--'
--' `Try` is a generated type that native code cannot name, so the pull is
--' adapted to an `(ok, message, batch)` triple and a read failure comes back
--' as `(False, message, ...)`. A failure inside `f` or `combine` propagates.
--'
--' Map and filter have their own primitives rather than wrapping `f` in a
--' list-valued lambda for `psconcatMapNative`, so `f` reaches native code as
--' the function it is rather than as a closure over it.
psconcatMapNative
  :: ParOpts
  -> (a -> [b])
  -> <IO> (Bool, Str, [a])
  -> ([b] -> <IO> ())
  -> <IO> (Bool, Str)

psmapNative
  :: ParOpts
  -> (a -> b)
  -> <IO> (Bool, Str, [a])
  -> ([b] -> <IO> ())
  -> <IO> (Bool, Str)

psfilterNative
  :: ParOpts
  -> (a -> Bool)
  -> <IO> (Bool, Str, [a])
  -> ([a] -> <IO> ())
  -> <IO> (Bool, Str)

psfoldNative
  :: ParOpts
  -> (b -> b -> b)
  -> b
  -> (a -> b)
  -> <IO> (Bool, Str, [a])
  -> <IO> (Bool, Str, b)

--' Raise the read failure a map-shaped native stage reports.
raiseRead :: <IO> (Bool, Str) -> <IO> ()
raiseRead stage = do
  r <- stage
  ? .0 r = () : @throw (.1 r)

--' Turn a native fold's result into a `Try`.
foldResult :: <IO> (Bool, Str, b) -> <IO> (Try Str b)
foldResult stage = do
  r <- stage
  ? .0 r = Ok (.2 r) : Err (.1 r)

--' Adapt a pull to the triple the native primitives take.
pullParts :: <IO> (Try Str [a]) -> <IO> (Bool, Str, [a])
pullParts pull = do
  r <- pull
  match r
    | (Err e) = (False, e, [])
    | (Ok xs) = (True, "", xs)


-- Stream files
----------------

--' Map a stream file into another stream file, in parallel, writing the
--' output at the given zstd compression level (0 is uncompressed).
--'
--' This is the stream stage over files: the input is read one sub-packet at a
--' time, each is mapped in parallel as `psmapWith` maps a batch, and the
--' results are written in input order. Reading (with decompression) and
--' writing (with compression) happen on the calling thread; only `f` runs on
--' the workers, so a cheap `f` over a compressed file is limited by the
--' reading and writing rather than by the mapping.
--'
--' Any failure -- opening, reading, writing, or in `f` -- is returned as `Err`.
pfmapToWith :: ParOpts -> Int -> (a -> b) -> IFile [a] -> Str -> <IO> (Try Str ())
pfmapToWith opts level f file dest = @try (fileToFile opts level f file dest)

--' The same over the morloc stream loop ('psmapWithPure'), which reads, maps
--' and writes one sub-packet at a time.
pfmapToWithPure :: ParOpts -> Int -> (a -> b) -> IFile [a] -> Str -> <IO> (Try Str ())
pfmapToWithPure opts level f file dest = @try (fileToFilePure opts level f file dest)

pfmapTo :: (a -> b) -> IFile [a] -> Str -> <IO> (Try Str ())
pfmapTo f file dest = pfmapToWith defaultParOpts 0 f file dest

fileToFile :: ParOpts -> Int -> (a -> b) -> IFile [a] -> Str -> <IO> ()
fileToFile opts level f file dest = do
  s <- @stream file
  Ok o <- @open dest
  psmapWith opts f (@next s) (writeAt level o)
  @close o
  @close s

fileToFilePure :: ParOpts -> Int -> (a -> b) -> IFile [a] -> Str -> <IO> ()
fileToFilePure opts level f file dest = do
  s <- @stream file
  Ok o <- @open dest
  psmapWithPure opts f (@next s) (writeAt level o)
  @close o
  @close s

--' Write a batch as a sub-packet at a compression level; a write failure
--' aborts the stage.
writeAt :: Int -> OStream b -> [b] -> <IO> ()
writeAt level o xs = do
  Ok _ <- @write level o xs
  ()
